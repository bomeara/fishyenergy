me(legend.position = \"none\") +     labs(x = \"Day of year\", y = \"Water temperature (°C)\") +     scale_x_continuous(expand = c(0,0), limits = c(0,365), breaks = seq(0,360,60)) +     scale_y_continuous(expand = c(0,0), limits = c(0,40), breaks = seq(0,40,10)) +     geom_line(aes(x = date, y = WT_mean, group = COMID), temps_casc.long, linewidth = 0.5, alpha = 0.1)"},{"path":"https://bomeara.github.io/fishyenergy/articles/Mapping_BrookTrout.html","id":"section-7","dir":"Articles","previous_headings":"","what":"Mapping Brook trout","title":"Mapping Brook trout","text":"Let’s map spatial variation temperature.","code":"temps_casc.mean <- aggregate(WT_mean ~ COMID, temps_casc.long, FUN = mean)  data(envir_casc)  vect.temps_casc.mean <- merge(x = envir_casc, y = temps_casc.mean, by = \"COMID\")  ggplot(NULL) + theme_classic() +   scale_color_gradient(low = \"blue\", high = \"red\") +   geom_sf(aes(color = WT_mean), data = vect.temps_casc.mean, size = 1.5, shape = 16)"},{"path":"https://bomeara.github.io/fishyenergy/articles/Mapping_BrookTrout.html","id":"section-8","dir":"Articles","previous_headings":"","what":"Mapping Brook trout","title":"Mapping Brook trout","text":"Run bem_project function grow fish n habitat patches. sure set .raster argument FALSE temperature input tabular form raster.","code":"output.casc <- bem_project(start_M2 = 13,                            temperature = temps_casc,                            parms.intrinsic = parms.salfon,                            parms.temporal = parms_temporal_DEFAULT,                            C_eq = 2,                            R_eq = 2,                            is.raster = FALSE)"},{"path":"https://bomeara.github.io/fishyenergy/articles/Mapping_BrookTrout.html","id":"section-9","dir":"Articles","previous_headings":"","what":"Mapping Brook trout","title":"Mapping Brook trout","text":"Output bem_project list length three. first list element run time. bem_project function, like bem_validate function, takes time run